{
  "trailingSlash": false,
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "header",
          "key": "x-forwarded-proto",
          "value": "http"
        }
      ],
      "destination": "https://www.contabilidadrs.cl/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "key": "",
          "value": "contabilidadrs.cl"
        }
      ],
      "destination": "https://www.contabilidadrs.cl/$1",
      "permanent": true
    },
    {
      "source": "/Sobre-nosotros",
      "destination": "/sobre-nosotros",
      "permanent": true
    },
    {
      "source": "/Contactos",
      "destination": "/contacto",
      "permanent": true
    },
    {
      "source": "/contactos",
      "destination": "/contacto",
      "permanent": true
    },
    {
      "source": "/Servicios",
      "destination": "/servicios",
      "permanent": true
    },
    {
      "source": "/Blog",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/wb_popup:(.*)",
      "destination": "/",
      "permanent": true
    }
  ]
}
